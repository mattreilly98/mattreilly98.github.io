        "responses": {
          "values": [
            {
              "content": "=    You are a scheduling assistant. Extract booking details from the user's message and return ONLY valid JSON, no markdown, no commentary.\n\n    Today's date and time is: {{ $json.current_datetime }} ({{ $json.user_timezone }})\n\n    Return this exact JSON shape:\n    {\n      \"intent\": \"book_appointment\" or \"unclear\",\n      \"requested_date\": \"YYYY-MM-DD\" or null,\n      \"requested_time_period\": \"morning\", \"afternoon\", \"evening\", \"specific\", or null,\n      \"requested_time\": \"HH:MM\" or null,\n      \"duration_minutes\": number,\n      \"attendee_name\": string or null,\n      \"attendee_email\": string or null\n    }\n\n    Rules:\n    - Resolve relative dates (\"next Tuesday\", \"tomorrow\") against today's date above.\n    - If no duration is mentioned, default to 30.\n    - If the message isn't a booking request, set intent to \"unclear\".\n\n\nUser's message: {{ $json.raw_message }}"
            }
          ]
        },
