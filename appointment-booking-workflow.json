    {
      "parameters": {
        "jsCode": "const data = $('Parse & Resolve Time').first().json;\nconst tz = data.timezone || 'Europe/London';\n\nconst start = DateTime.fromISO(data.window_start_iso, { setZone: true });\nconst duration = data.duration_minutes || 30;\n\n// offer: 1hr later same day, 2hrs later same day, same time next day\nconst alt1 = start.plus({ hours: 1 });\nconst alt2 = start.plus({ hours: 2 });\nconst alt3 = start.plus({ days: 1 });\n\nconst alternatives = [alt1, alt2, alt3].map(dt => ({\n  start_iso: dt.toISO(),\n  end_iso: dt.plus({ minutes: duration }).toISO(),\n  display: dt.toFormat(\"cccc, d LLLL 'at' h:mm a\")\n}));\n\nreturn [{\n  json: {\n    ...data,\n    alternatives,\n  }\n}];"
      },
