    {
      "parameters": {
        "jsCode": "let parsed;\ntry {\n  const raw = $input.first().json.output[0].content[0].text;\n  const clean = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch (e) {\n  return [{ json: { error: true, reason: 'AI output not valid JSON' } }];\n}\n\nif (parsed.intent !== 'book_appointment' || !parsed.requested_date) {\n  return [{ json: { error: true, reason: 'Could not extract a clear booking request', parsed } }];\n}\n\nconst TIME_WINDOWS = {\n  morning: '10:00',\n  afternoon: '14:00',\n  evening: '17:00',\n};\n\nconst tz = $('Set Context').first().json.user_timezone || 'Europe/London';\nconst date = parsed.requested_date;\nconst duration = parsed.duration_minutes || 30;\n\n// use the exact time if given, otherwise a default start for the period\nconst startTime = parsed.requested_time\n  || TIME_WINDOWS[parsed.requested_time_period]\n  || TIME_WINDOWS.afternoon;\n\nconst windowStart = DateTime.fromISO(`${date}T${startTime}`, { zone: tz });\nconst windowEnd = windowStart.plus({ minutes: duration })\n\nconst webhookData = $('Receive Booking Request').first().json.body;\n\nreturn [{\n  json: {\n    error: false,\n    ...parsed,\n    attendee_name: webhookData.name || parsed.attendee_name,\n    attendee_email: webhookData.email || parsed.attendee_email,\n    window_start_iso: windowStart.toISO(),\n    window_end_iso: windowEnd.toISO(),\n    duration_minutes: duration,\n    timezone: tz,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        -32
      ],
